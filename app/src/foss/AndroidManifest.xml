<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Play edition: use scoped storage / MediaStore instead of broad all-files access. -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:node="remove" />

    <!-- Not required by the Play edition. -->
    <uses-permission
        android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.POST_PROMOTED_NOTIFICATIONS"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACTION_OPEN_DOCUMENT"
        tools:node="remove" />

    <application
        android:label="حمّل"
        tools:replace="android:label" />
</manifest>
