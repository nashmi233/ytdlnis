<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center_vertical" android:padding="24dp"
    android:background="?android:attr/colorBackground">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/app_name" android:textAppearance="?attr/textAppearanceHeadlineMedium" />
    <TextView android:id="@+id/update_status" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="24dp"
        android:text="@string/nash_checking_update" android:textAppearance="?attr/textAppearanceBodyLarge" />
    <ProgressBar android:id="@+id/update_progress" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="16dp" android:max="100" />
    <com.google.android.material.button.MaterialButton android:id="@+id/update_action"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="24dp" android:text="@string/nash_retry_update" android:visibility="gone" />
    <com.google.android.material.button.MaterialButton android:id="@+id/update_cancel"
        style="?attr/borderlessButtonStyle" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="@string/cancel" />
</LinearLayout>
