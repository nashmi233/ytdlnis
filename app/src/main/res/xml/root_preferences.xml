<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory android:title="إعدادات سريعة">

        <SwitchPreferenceCompat
            android:widgetLayout="@layout/preferece_material_switch"
            app:defaultValue="true"
            app:icon="@drawable/ic_clipboard"
            app:key="auto_detect_clipboard"
            app:summary="@string/hammel_auto_detect_clipboard_summary"
            app:title="@string/hammel_auto_detect_clipboard_title" />

        <SwitchPreferenceCompat
            android:widgetLayout="@layout/preferece_material_switch"
            app:defaultValue="false"
            app:icon="@drawable/ic_downloads"
            app:key="auto_download_copied_link"
            app:summary="@string/hammel_auto_download_copied_link_summary"
            app:title="@string/hammel_auto_download_copied_link_title" />

        <SwitchPreferenceCompat
            android:widgetLayout="@layout/preferece_material_switch"
            app:defaultValue="true"
            app:icon="@drawable/baseline_save_alt_24"
            app:key="save_to_gallery"
            app:summary="@string/hammel_save_to_gallery_summary"
            app:title="@string/hammel_save_to_gallery_title" />

        <SwitchPreferenceCompat
            android:widgetLayout="@layout/preferece_material_switch"
            app:defaultValue="true"
            app:icon="@drawable/baseline_share2_24"
            app:key="ask_tiktok_download_type"
            app:summary="@string/hammel_ask_tiktok_download_type_summary"
            app:title="@string/hammel_ask_tiktok_download_type_title" />

    </PreferenceCategory>

    <PreferenceCategory android:title="إعدادات إضافية">
        <Preference
            android:key="appearance"
            app:icon="@drawable/ic_settings"
            android:title="@string/general"/>

        <Preference
            android:key="folders"
            app:icon="@drawable/baseline_folder_24"
            android:title="@string/directories"/>

        <Preference
            android:key="downloading"
            app:icon="@drawable/ic_downloads"
            android:title="@string/downloads"/>

        <Preference
            android:key="processing"
            app:icon="@drawable/baseline_star_half_24"
            android:title="@string/processing"/>

        <Preference
            android:key="updating"
            app:icon="@drawable/ic_update"
            android:title="@string/updating"/>

        <Preference
            android:key="advanced"
            app:icon="@drawable/baseline_settings_suggest_24"
            android:title="@string/advanced"/>
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/backup_restore">
        <Preference
            app:icon="@drawable/baseline_save_alt_24"
            app:key="backup"
            app:title="@string/backup"/>

        <Preference
            app:icon="@drawable/baseline_restore_page_24"
            app:key="restore"
            app:title="@string/restore"/>

        <SwitchPreferenceCompat
            android:widgetLayout="@layout/preferece_material_switch"
            app:defaultValue="true"
            app:icon="@drawable/ic_clock"
            app:key="automatic_backup"
            android:summary="@string/automatic_backup_summary"
            app:title="@string/automatic_backup" />

        <Preference
            app:icon="@drawable/baseline_folder_24"
            android:summary=""
            app:key="backup_path"
            app:title="@string/backup_path" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/about" >
        <Preference app:key="hammel_about" app:title="حمّل" app:summary="تنزيل الفيديو والصوت من الروابط ومشاركتها مباشرة إلى التطبيق." app:selectable="false" />
        <Preference app:key="hammel_developer" app:title="تطوير وتخصيص" app:summary="@string/hammel_developer" app:selectable="false" />
        <Preference app:key="hammel_version" app:title="الإصدار" app:selectable="false" />
        <Preference
            app:icon="@drawable/baseline_exit_to_app_24"
            app:key="package_name"
            app:title="@string/package_name" />



<Preference
            app:icon="@drawable/baseline_security_24"
            app:key="security"
            app:summary="البيانات والأذونات والاتصالات الخارجية"
            app:title="@string/security">
            <intent
                android:action="android.intent.action.VIEW"
                android:data="https://github.com/nashmi233/ytdlnis/blob/custom-app/PRIVACY.md" />
        </Preference>

        <Preference
            app:icon="@drawable/ic_license"
            app:key="license"
            app:summary="GNU General Public License v3.0"
            app:title="@string/license">
            <intent
                android:action="android.intent.action.VIEW"
                android:data="https://github.com/nashmi233/ytdlnis/blob/custom-app/LICENSE" />
        </Preference>

        <Preference
            app:icon="@drawable/ic_code"
            app:key="rreth"
            app:summary="المشروع المفتوح المصدر"
            app:allowDividerBelow="true"
            app:title="@string/source_code">
            <intent
                android:action="android.intent.action.VIEW"
                android:data="https://github.com/nashmi233/ytdlnis" />
        </Preference>
    </PreferenceCategory>

</PreferenceScreen>
